{
  "name": "OneDrive PDF OCR Classification",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "search",
        "driveId": {
          "__rl": true,
          "value": "me",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "root:/ToProcess:",
          "mode": "list"
        },
        "query": "*.pdf"
      },
      "id": "list-files",
      "name": "List PDFs in ToProcess",
      "type": "n8n-nodes-base.microsoftOneDrive",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "microsoftOneDriveOAuth2Api": {
          "id": "1",
          "name": "OneDrive Account"
        }
      }
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": "={{ $json.id }}"
      },
      "id": "download-file",
      "name": "Download PDF",
      "type": "n8n-nodes-base.microsoftOneDrive",
      "typeVersion": 2,
      "position": [650, 300],
      "credentials": {
        "microsoftOneDriveOAuth2Api": {
          "id": "1",
          "name": "OneDrive Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Convert PDF binary to base64 for Gemini\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const binaryData = item.binary.data;\n  const base64Data = binaryData.toString('base64');\n  \n  results.push({\n    json: {\n      fileName: item.json.name,\n      fileId: item.json.id,\n      base64Content: base64Data,\n      mimeType: 'application/pdf'\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "convert-to-base64",
      "name": "Convert to Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApiKeyApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "={{ [{\n  \"parts\": [\n    {\n      \"text\": \"Analyze this document and classify it into ONE of these categories: Invoice, Bank Statement, Tax Record, or Executive Report. Respond with ONLY the category name, nothing else.\"\n    },\n    {\n      \"inline_data\": {\n        \"mime_type\": $json.mimeType,\n        \"data\": $json.base64Content\n      }\n    }\n  ]\n}] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "gemini-classify",
      "name": "Gemini Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 300],
      "credentials": {
        "googleApiKeyApi": {
          "id": "2",
          "name": "Google API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract classification from Gemini response\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const geminiResponse = item.json.candidates[0].content.parts[0].text.trim();\n  \n  // Map classification to folder\n  let targetFolder = 'Unclassified';\n  \n  if (geminiResponse.toLowerCase().includes('invoice')) {\n    targetFolder = 'Invoices';\n  } else if (geminiResponse.toLowerCase().includes('bank statement')) {\n    targetFolder = 'BankStatements';\n  } else if (geminiResponse.toLowerCase().includes('tax record')) {\n    targetFolder = 'TaxRecords';\n  } else if (geminiResponse.toLowerCase().includes('executive report')) {\n    targetFolder = 'ExecutiveReports';\n  }\n  \n  results.push({\n    json: {\n      fileName: item.json.fileName,\n      fileId: item.json.fileId,\n      classification: geminiResponse,\n      targetFolder: targetFolder,\n      processedAt: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "parse-classification",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "move",
        "fileId": "={{ $json.fileId }}",
        "parentId": {
          "__rl": true,
          "value": "={{ 'root:/Processed/' + $json.targetFolder + ':' }}",
          "mode": "list"
        }
      },
      "id": "move-file",
      "name": "Move to Classified Folder",
      "type": "n8n-nodes-base.microsoftOneDrive",
      "typeVersion": 2,
      "position": [1450, 300],
      "credentials": {
        "microsoftOneDriveOAuth2Api": {
          "id": "1",
          "name": "OneDrive Account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "leftValue": "={{ $json.name }}",
              "rightValue": ".pdf",
              "operator": {
                "type": "string",
                "operation": "endsWith"
              }
            }
          ]
        }
      },
      "id": "filter-pdfs",
      "name": "Filter PDFs Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [850, 200]
    }
  ],
